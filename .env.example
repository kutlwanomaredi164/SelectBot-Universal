# ==============================================================================
# SelectBot SaaS Platform — Environment Variables
# ==============================================================================

# --- SUPABASE CONFIGURATION (Central Project Owned by Platform Operator) ---
# VITE_SUPABASE_URL: Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project URL
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# VITE_SUPABASE_ANON_KEY: Your Supabase Publishable / Anon API Key (Safe for browser)
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys (anon / public)
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key-here"

# SUPABASE_SERVICE_ROLE_KEY: Server-side privileged key for authorized backend endpoints only.
# CRITICAL: Never prefix with VITE_ and never expose to client bundles or browser responses.
# Found in: Supabase Dashboard -> Project Settings -> API -> Project API Keys (service_role / secret)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-here"

# --- AI PROVIDER CONFIGURATION ---
# GEMINI_API_KEY: Required for Gemini AI responses. In AI Studio this is automatically injected.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- APPLICATION HOSTING ---
# APP_URL: The base URL where this app is hosted (e.g. https://my-chatbot-saas.vercel.app)
# Used for generating absolute links for standalone chat pages, embed snippets, and CORS.
APP_URL="MY_APP_URL"
